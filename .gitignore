# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# OS / archive junk
__MACOSX/
.DS_Store
Thumbs.db

# Secrets — never commit real values, only .env.example
.env

# Regeneratable intermediate data — too large to be worth pushing
# (rebuild via Docker + fMRIPrep, see fmriprep_out/README.md)
fmriprep_out/*
!fmriprep_out/README.md

# Real runtime data — these must not be committed
NeuroVision_Final/database.db
NeuroVision_Final/uploads/*
!NeuroVision_Final/uploads/.gitkeep
NeuroVision_Final/previews/*
!NeuroVision_Final/previews/.gitkeep

# NeuroVision_Final/soft_voting_deployment/*.pkl and models/*.pkl are
# small enough (~1-12MB) to commit directly — not excluded.
